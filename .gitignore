# Python
__pycache__/
*.py[cod]
.venv/
.runtime-deps/
venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets
.env
*.key

# Raw/private data: DO NOT COMMIT video files
/data/raw/**
!/data/raw/
!/data/raw/*/
!/data/raw/.gitkeep
!/data/raw/**/metadata.json

# Generated datasets/artifacts
/data/poses/*
!/data/poses/.gitkeep
/data/poses_zones/*
/data/features/*
!/data/features/.gitkeep
/data/features_zones/*
/data/features_v2/*
/data/features_context_v0_2/
/data/annotations/human_review_v0_2/
/data/annotations/.preview_cache/
/releases/

# Synthetic annotations kept only for local audit
/data/annotations/deprecated/

# Model checkpoints
*.pt
*.pth
*.ckpt

# Experiment outputs: keep reproducibility metadata and small result tables,
# ignore large/derived artifacts.
/reports/experiments/*/
!/reports/experiments/*/
/reports/experiments/*/*
!/reports/experiments/*/metadata.json
!/reports/experiments/*/config.yaml
!/reports/experiments/*/metrics.json
!/reports/experiments/*/evaluation_report.json
!/reports/experiments/*/predictions.csv
!/reports/experiments/*/zone_predictions.csv
!/reports/experiments/*/zone_evaluation_report.json
!/reports/experiments/*/training_history.csv
!/reports/experiments/*/split_report.json
!/reports/experiments/*/notes.md

# Local legacy artifacts
/reports/legacy/
/reports/inference/
.pytest_tmp/

# Explicit checkpoint directory (keep directory marker/README only)
/models/checkpoints/*
!/models/checkpoints/.gitkeep

# Jupyter
.ipynb_checkpoints/

# Test caches
.pytest_cache/
.pytest_temp/
/data/annotations/relabel_reviews/
